#!/usr/bin/env python3
import json
import os
import re
import shlex
import sys
from pathlib import Path
from urllib.parse import quote_plus, urlparse

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.0")
from gi.repository import Gtk, Gdk, GLib, Gio, WebKit2

APP_DIR = Path.home() / ".config" / "nsk-browser"
DOWNLOADS = Path.home() / "Downloads"
BOOKMARKS = APP_DIR / "bookmarks.json"
HISTORY = APP_DIR / "history.json"
DOWNLOADS.mkdir(parents=True, exist_ok=True)
APP_DIR.mkdir(parents=True, exist_ok=True)

DEFAULT_URL = "https://duckduckgo.com/"
AD_HOSTS = {
    "doubleclick.net", "googlesyndication.com", "googleadservices.com",
    "adservice.google.com", "ads.yahoo.com", "adnxs.com", "adform.net",
    "taboola.com", "outbrain.com", "scorecardresearch.com"
}
DARK_CSS = """
html,body { background:#101827 !important; color:#e8f0fb !important; }
body * { border-color:#33435a !important; }
input,textarea,select { background:#182438 !important; color:#eef6ff !important; }
a { color:#79b7ff !important; }
"""
LIGHT_CSS = """
html,body { background:#ffffff; }
"""

def load_json(path, fallback):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return fallback

def save_json(path, data):
    path.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")

class BrowserTab(Gtk.Box):
    def __init__(self, browser, url=DEFAULT_URL, private=False):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.browser = browser
        self.private = private
        context = WebKit2.WebContext.new_ephemeral() if private else WebKit2.WebContext.get_default()
        self.web = WebKit2.WebView.new_with_context(context)
        settings = self.web.get_settings()
        settings.set_enable_javascript(True)
        settings.set_enable_media(True)
        settings.set_enable_plugins(False)
        settings.set_enable_developer_extras(False)
        settings.set_hardware_acceleration_policy(
            WebKit2.HardwareAccelerationPolicy.ALWAYS
        )
        self.web.connect("notify::title", self.on_title)
        self.web.connect("notify::uri", self.on_uri)
        self.web.connect("load-changed", self.on_load)
        self.web.connect("decide-policy", self.on_policy)
        self.web.connect("create", self.on_create)
        self.web.connect("enter-fullscreen", self.on_fullscreen)
        self.web.connect("leave-fullscreen", self.on_leave_fullscreen)
        self.web.connect("download-started", self.on_download_started)
        self.pack_start(self.web, True, True, 0)
        self.show_all()
        self.load(url)

    def load(self, target):
        target = target.strip()
        if not target:
            return
        if "://" not in target and not target.startswith("about:"):
            if re.match(r"^[\w.-]+\.[a-zA-Z]{2,}(/.*)?$", target):
                target = "https://" + target
            else:
                target = "https://duckduckgo.com/?q=" + quote_plus(target)
        self.web.load_uri(target)

    def on_title(self, *_):
        self.browser.update_tab_title(self)

    def on_uri(self, *_):
        if self.browser.current_tab() is self:
            self.browser.url.set_text(self.web.get_uri() or "")
        self.browser.update_nav_buttons()

    def on_load(self, _web, event):
        if event == WebKit2.LoadEvent.FINISHED:
            uri = self.web.get_uri() or ""
            if uri and not self.private:
                hist = load_json(HISTORY, [])
                hist.append({"title": self.web.get_title() or uri, "url": uri})
                save_json(HISTORY, hist[-300:])
            self.apply_page_style()
        self.browser.update_nav_buttons()

    def on_policy(self, _web, decision, decision_type):
        if decision_type != WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            return False
        action = decision.get_navigation_action()
        req = action.get_request()
        uri = req.get_uri() or ""
        host = (urlparse(uri).hostname or "").lower()
        if any(host == h or host.endswith("." + h) for h in AD_HOSTS):
            decision.ignore()
            return True
        decision.use()
        return True

    def on_create(self, _web, navigation_action):
        uri = navigation_action.get_request().get_uri() or DEFAULT_URL
        self.browser.new_tab(uri)
        return self.browser.current_tab().web

    def on_download_started(self, _context, download):
        suggested = download.get_destination()
        if not suggested:
            response = download.get_response()
            name = Path(urlparse(response.get_uri()).path).name or "download"
            suggested = name
        name = Path(suggested.replace("file://", "")).name
        destination = DOWNLOADS / name
        index = 2
        while destination.exists():
            destination = DOWNLOADS / f"{destination.stem}-{index}{destination.suffix}"
            index += 1
        download.set_destination(destination.as_uri())
        download.start()

    def on_fullscreen(self, *_):
        self.browser.enter_fullscreen()
        return True

    def on_leave_fullscreen(self, *_):
        self.browser.exit_fullscreen()
        return True

    def apply_page_style(self):
        css = DARK_CSS if self.browser.dark else LIGHT_CSS
        manager = self.web.get_user_content_manager()
        manager.remove_all_style_sheets()
        provider = WebKit2.UserStyleSheet(
            css,
            WebKit2.UserContentInjectedFrames.ALL_FRAMES,
            WebKit2.UserStyleLevel.DOCUMENT,
            [], []
        )
        manager.add_style_sheet(provider)

    def desktop_site(self, enabled):
        settings = self.web.get_settings()
        if enabled:
            settings.set_user_agent(
                "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                "(KHTML, like Gecko) Chrome/120.0 Safari/537.36"
            )
        else:
            settings.set_user_agent("")
        self.web.reload()

class Browser(Gtk.Window):
    def __init__(self):
        super().__init__(title="NSK Browser")
        self.set_default_size(980, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("nsk-browser")
        self.dark = False
        self.desktop_mode = False
        self.bookmarks = load_json(BOOKMARKS, [])
        self.notebook = Gtk.Notebook()
        self.notebook.set_scrollable(True)
        self.notebook.set_show_border(False)
        self.notebook.connect("switch-page", self.on_switch)
        self.url = Gtk.Entry()
        self.url.set_placeholder_text("Search or enter address")
        self.url.set_icon_from_icon_name(Gtk.EntryIconPosition.PRIMARY, "system-search")
        self.url.connect("activate", self.on_url)
        self.build_ui()
        self.new_tab(DEFAULT_URL)
        self.show_all()

    def build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class("nsk-browser-root")
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        header.set_margin_start(8); header.set_margin_end(8)
        header.set_margin_top(7); header.set_margin_bottom(7)
        self.back = self.button("‹", self.go_back)
        self.forward = self.button("›", self.go_forward)
        self.reload = self.button("↻", self.reload_page)
        self.home = self.button("⌂", lambda *_: self.current_tab().load(DEFAULT_URL))
        self.tabs = self.button("1", self.show_tabs)
        self.menu = self.button("☰", self.show_menu)
        header.pack_start(self.back, False, False, 0)
        header.pack_start(self.forward, False, False, 0)
        header.pack_start(self.reload, False, False, 0)
        header.pack_start(self.home, False, False, 0)
        header.pack_start(self.url, True, True, 3)
        header.pack_start(self.tabs, False, False, 0)
        header.pack_start(self.menu, False, False, 0)
        root.pack_start(header, False, False, 0)
        root.pack_start(self.notebook, True, True, 0)
        self.add(root)
        css = Gtk.CssProvider()
        css.load_from_data(b"""
        .nsk-browser-root { background: rgba(255,255,255,0.72); }
        .nsk-browser-root button { min-width:32px; min-height:30px; border-radius:9px; }
        .nsk-browser-root entry { border-radius:18px; padding:7px 12px; background:rgba(255,255,255,.88); }
        """)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def button(self, text, callback):
        b = Gtk.Button(label=text)
        b.connect("clicked", callback)
        return b

    def new_tab(self, url=DEFAULT_URL, private=False):
        tab = BrowserTab(self, url, private)
        label = Gtk.Label(label="New Tab" if not private else "Private")
        close = Gtk.Button.new_from_icon_name("window-close", Gtk.IconSize.MENU)
        close.set_relief(Gtk.ReliefStyle.NONE)
        box = Gtk.Box(spacing=4)
        box.pack_start(label, True, True, 2)
        box.pack_start(close, False, False, 0)
        box.show_all()
        page = self.notebook.append_page(tab, box)
        close.connect("clicked", lambda *_: self.close_tab(tab))
        self.notebook.set_current_page(page)
        self.update_tab_title(tab)
        return tab

    def close_tab(self, tab):
        page = self.notebook.page_num(tab)
        if page >= 0:
            self.notebook.remove_page(page)
        if self.notebook.get_n_pages() == 0:
            self.new_tab()

    def current_tab(self):
        page = self.notebook.get_current_page()
        return self.notebook.get_nth_page(page)

    def update_tab_title(self, tab):
        page = self.notebook.page_num(tab)
        if page < 0:
            return
        child = self.notebook.get_tab_label(tab)
        if not isinstance(child, Gtk.Box):
            return
        label = child.get_children()[0]
        title = tab.web.get_title() or "New Tab"
        label.set_text(("Private • " if tab.private else "") + title[:24])
        if tab is self.current_tab():
            self.url.set_text(tab.web.get_uri() or "")
        self.tabs.set_label(str(self.notebook.get_n_pages()))

    def update_nav_buttons(self):
        tab = self.current_tab()
        if not tab:
            return
        self.back.set_sensitive(tab.web.can_go_back())
        self.forward.set_sensitive(tab.web.can_go_forward())

    def on_switch(self, *_):
        self.update_nav_buttons()
        tab = self.current_tab()
        if tab:
            self.url.set_text(tab.web.get_uri() or "")

    def on_url(self, *_):
        self.current_tab().load(self.url.get_text())

    def go_back(self, *_): self.current_tab().web.go_back()
    def go_forward(self, *_): self.current_tab().web.go_forward()
    def reload_page(self, *_): self.current_tab().web.reload()

    def show_tabs(self, *_):
        dialog = Gtk.Dialog(title="Tabs", transient_for=self, flags=Gtk.DialogFlags.MODAL)
        box = dialog.get_content_area()
        for i in range(self.notebook.get_n_pages()):
            tab = self.notebook.get_nth_page(i)
            b = Gtk.Button(label=(tab.web.get_title() or "New Tab")[:60])
            b.connect("clicked", lambda _b, n=i, d=dialog: (self.notebook.set_current_page(n), d.destroy()))
            box.pack_start(b, False, False, 4)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        dialog.show_all()
        dialog.run(); dialog.destroy()

    def show_menu(self, *_):
        menu = Gtk.Menu()
        def item(name, cb):
            m = Gtk.MenuItem(label=name); m.connect("activate", cb); menu.append(m)
        item("New tab", lambda *_: self.new_tab())
        item("Private tab", lambda *_: self.new_tab(DEFAULT_URL, True))
        item("Bookmark this page", self.add_bookmark)
        item("Bookmarks", self.show_bookmarks)
        item("History", self.show_history)
        item("Downloads", lambda *_: self.open_downloads())
        menu.append(Gtk.SeparatorMenuItem())
        dark = Gtk.CheckMenuItem(label="Dark mode"); dark.set_active(self.dark)
        dark.connect("toggled", self.toggle_dark); menu.append(dark)
        desktop = Gtk.CheckMenuItem(label="Desktop site"); desktop.set_active(self.desktop_mode)
        desktop.connect("toggled", self.toggle_desktop); menu.append(desktop)
        menu.append(Gtk.SeparatorMenuItem())
        item("Fullscreen", lambda *_: self.fullscreen())
        item("Exit", lambda *_: Gtk.main_quit())
        menu.show_all()
        menu.popup_at_widget(self.menu, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.NORTH_EAST, None)

    def add_bookmark(self, *_):
        tab = self.current_tab()
        uri = tab.web.get_uri() or ""
        if uri and uri not in [x.get("url") for x in self.bookmarks]:
            self.bookmarks.append({"title": tab.web.get_title() or uri, "url": uri})
            save_json(BOOKMARKS, self.bookmarks)

    def show_bookmarks(self, *_):
        self.show_link_list("Bookmarks", self.bookmarks)

    def show_history(self, *_):
        self.show_link_list("History", list(reversed(load_json(HISTORY, [])))[:100])

    def show_link_list(self, title, rows):
        dialog = Gtk.Dialog(title=title, transient_for=self)
        box = dialog.get_content_area()
        for row in rows:
            b = Gtk.Button(label=row.get("title", row.get("url", ""))[:80])
            b.connect("clicked", lambda _b, u=row.get("url", ""), d=dialog: (self.current_tab().load(u), d.destroy()))
            box.pack_start(b, False, False, 3)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        dialog.set_default_size(560, 420)
        dialog.show_all(); dialog.run(); dialog.destroy()

    def open_downloads(self):
        Gio.AppInfo.launch_default_for_uri(DOWNLOADS.as_uri(), None)

    def toggle_dark(self, check):
        self.dark = check.get_active()
        for i in range(self.notebook.get_n_pages()):
            self.notebook.get_nth_page(i).apply_page_style()

    def toggle_desktop(self, check):
        self.desktop_mode = check.get_active()
        self.current_tab().desktop_site(self.desktop_mode)

    def enter_fullscreen(self):
        Gtk.Window.fullscreen(self)

    def exit_fullscreen(self):
        Gtk.Window.unfullscreen(self)

if __name__ == "__main__":
    Browser().connect("destroy", Gtk.main_quit)
    Gtk.main()
