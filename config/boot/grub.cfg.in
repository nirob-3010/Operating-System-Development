set default=0
set timeout=5
set gfxmode=auto
insmod all_video
insmod gfxterm
terminal_output gfxterm
set color_normal=black/light-gray
set color_highlight=white/blue

menuentry "Start NSK OS" {
    linux /boot/__KERNEL__ loglevel=3 noswap desktop=jwm host=nsk-os
    initrd /boot/__INITRD__
}

menuentry "Safe Graphics Mode" {
    linux /boot/__KERNEL__ loglevel=3 noswap base desktop=jwm host=nsk-os
    initrd /boot/__INITRD__
}

menuentry "Recovery / Debug Mode" {
    linux /boot/__KERNEL__ loglevel=7 norestore base text
    initrd /boot/__INITRD__
}
