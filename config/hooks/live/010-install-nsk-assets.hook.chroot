#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --no-install-recommends \
  fontconfig curl ca-certificates locales dbus-x11 \
  network-manager network-manager-gnome \
  libgtk-3-0 libwebkit2gtk-4.0-37

# Replace the generic live user with the fixed NSK account.
if id live >/dev/null 2>&1; then userdel -r live || true; fi
if ! id nsk >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G audio,video,plugdev,netdev,sudo nsk
fi
echo 'nsk:nsk' | chpasswd
printf 'nsk ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/90-nsk
chmod 0440 /etc/sudoers.d/90-nsk
printf 'nskos\n' > /etc/hostname
cat > /etc/hosts <<'EOF'
127.0.0.1 localhost
127.0.1.1 nskos
::1 localhost ip6-localhost ip6-loopback
EOF

# Locale policy: English plus Bengali only.
printf 'en_US.UTF-8 UTF-8\nbn_BD.UTF-8 UTF-8\n' > /etc/locale.gen
locale-gen
printf 'LANG=en_US.UTF-8\nLANGUAGE=en_US:en:bn\n' > /etc/default/locale

# Install exactly the requested UI fonts from their upstream repositories.
mkdir -p /usr/share/fonts/truetype/nsk
curl -L --fail --silent --show-error \
  'https://github.com/google/fonts/raw/main/ofl/inter/Inter%5Bopsz%2Cwght%5D.ttf' \
  -o /usr/share/fonts/truetype/nsk/Inter.ttf
curl -L --fail --silent --show-error \
  'https://github.com/google/fonts/raw/main/ofl/jetbrainsmono/JetBrainsMono%5Bwght%5D.ttf' \
  -o /usr/share/fonts/truetype/nsk/JetBrainsMono.ttf
curl -L --fail --silent --show-error \
  'https://raw.githubusercontent.com/notofonts/noto-sans-bengali/main/unhinted/ttf/NotoSansBengali-Regular.ttf' \
  -o /usr/share/fonts/truetype/nsk/NotoSansBengali.ttf

# Remove extra font families pulled by the desktop stack.
find /usr/share/fonts/truetype -type f \
  ! -path '/usr/share/fonts/truetype/nsk/*' \
  -delete || true
find /usr/share/fonts/opentype -type f -delete 2>/dev/null || true
find /usr/share/fonts/X11 -type f -delete 2>/dev/null || true
fc-cache -f

# Make the account look like a live desktop immediately.
install -d -o nsk -g nsk /home/nsk/Desktop /home/nsk/Downloads
cp -a /etc/skel/. /home/nsk/
chown -R nsk:nsk /home/nsk
chmod +x /home/nsk/Desktop/*.desktop 2>/dev/null || true

# Prefer the NSK theme/icon set globally.
install -d /etc/xdg/xfce4
cat > /etc/xdg/xfce4/xinitrc <<'EOF'
#!/bin/sh
exec startxfce4
EOF
chmod +x /etc/xdg/xfce4/xinitrc

# LightDM uses the NSK account and theme.
sed -i 's/^user-session=.*/user-session=xfce/' /etc/lightdm/lightdm.conf.d/50-nsk.conf
