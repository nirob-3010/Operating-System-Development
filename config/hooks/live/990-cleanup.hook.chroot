#!/bin/sh
set -eu
export DEBIAN_FRONTEND=noninteractive

# Remove packages and artifacts that are not part of the desktop.
apt-get purge -y --auto-remove \
  aptitude tasksel tasksel-data \
  dictionaries-common man-db manpages \
  >/dev/null 2>&1 || true

printf 'en\nbn\nen_US\nbn_BD\n' > /etc/locale.nopurge
localepurge >/dev/null 2>&1 || true

# Keep only English and Bengali locale data.
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d \
  ! -name 'en' ! -name 'en_US' ! -name 'bn' ! -name 'bn_BD' \
  -exec rm -rf {} + 2>/dev/null || true

# The ISO is intentionally a live desktop, not a development environment.
rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* || true
rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/cache/debconf/* || true
rm -rf /tmp/* /var/tmp/* /var/log/*.log /var/log/apt/* || true
rm -f /etc/machine-id
ln -s /run/machine-id /etc/machine-id 2>/dev/null || true

# Strip bytecode, caches and static archives.
find /usr -type d -name '__pycache__' -prune -exec rm -rf {} + 2>/dev/null || true
find /usr -type f \( -name '*.a' -o -name '*.la' \) -delete 2>/dev/null || true
find /usr/share/icons -type f -name '*.cache' -delete 2>/dev/null || true
fc-cache -f >/dev/null 2>&1 || true

# Ensure correct permissions after all cleanup.
chown -R nsk:nsk /home/nsk
chmod 0440 /etc/sudoers.d/90-nsk
