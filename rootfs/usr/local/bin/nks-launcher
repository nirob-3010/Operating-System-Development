#!/bin/sh
if command -v Xdialog >/dev/null 2>&1; then
  CHOICE=$(Xdialog --stdout --title "NSK OS" --menu "Applications" 15 54 8 \
    "File Manager" "Browse files" \
    "Terminal" "Open terminal" \
    "Settings" "System settings" \
    "System Monitor" "CPU / RAM / Disk" \
    "OS Info" "About NSK OS" \
    "Power" "Shutdown or restart" 2>/dev/null) || exit 0
  case "$CHOICE" in
    "File Manager") exec rox ;;
    "Terminal") exec aterm ;;
    "Settings") exec /usr/local/bin/nks-settings ;;
    "System Monitor") exec /usr/local/bin/nks-monitor ;;
    "OS Info") exec aterm -e sh -lc '/usr/local/bin/nks-info; printf "\nPress Enter..."; read _' ;;
    "Power") exec /usr/local/bin/nks-power ;;
  esac
else
  exec aterm
fi
