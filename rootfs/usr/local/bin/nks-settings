#!/bin/sh
set -e
if ! command -v Xdialog >/dev/null 2>&1; then exec aterm -e sh -lc 'echo "NSK Settings"; /usr/local/bin/nks-info; read _'; fi
while :; do
  CHOICE=$(Xdialog --stdout --title "NSK OS Settings" --menu "Choose a section" 16 60 8 \
    "Appearance" "Wallpaper and theme" \
    "Display" "Resolution and screen info" \
    "Network" "Network status" \
    "System" "CPU, RAM, storage, OS version" \
    "Power" "Shutdown, restart, logout" \
    "About" "NSK OS 1.0" 2>/dev/null) || exit 0
  case "$CHOICE" in
    "Appearance")
      Xdialog --title "Appearance" --msgbox "Wallpaper: NSK supplied wallpaper\nTheme: Light\nAccent: Blue\nUI scaling: managed by X and WM" 10 56
      ;;
    "Display")
      if command -v xrandr >/dev/null 2>&1; then xrandr | Xdialog --title "Display" --textbox - 30 90; else Xdialog --msgbox "xrandr is not available in this build." 8 48; fi
      ;;
    "Network")
      sh -c 'echo "Interfaces:"; ip -br addr 2>/dev/null || ifconfig 2>/dev/null; echo; echo "Route:"; ip route 2>/dev/null || route -n 2>/dev/null' | Xdialog --title "Network" --textbox - 24 80
      ;;
    "System")
      /usr/local/bin/nks-info | Xdialog --title "System Information" --textbox - 24 80
      ;;
    "Power")
      exec /usr/local/bin/nks-power
      ;;
    "About")
      Xdialog --title "About NSK OS" --msgbox "NSK OS 1.0\nLightweight Desktop Operating System\n\nDeveloper: NSK Nirob Sarkar\nBase: Tiny Core Linux" 12 58
      ;;
  esac
done
