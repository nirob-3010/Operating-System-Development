#!/bin/bash
B=$'\e[1;34m'; R=$'\e[0m'; G=$'\e[90m'
up=$(awk '{s=int($1);h=int(s/3600);m=int(s%3600/60); if(h>0)printf "%dh %dm",h,m; else printf "%dm",m}' /proc/uptime)
mapfile -t art < <(awk 'BEGIN{R=8.5;r=4.5;for(y=-8;y<=8;y++){s="";for(x=-17;x<=17;x++){d=sqrt((x/2)^2+y^2);if(d>R||d<r)c=" ";else if(d>R-1)c="+";else if(d<r+1)c=":";else c="s";s=s c}print s}}')
info=("" "" "${B}NSK OS${R} v0.3" "" "${B}Host${R}   : NSK-PC" "${B}Kernel${R} : 0.3.0" "${B}Uptime${R} : $up" "${B}Shell${R}  : bash" "${B}Resolution${R}: 1024x768" "${B}DE${R}     : NSK Desktop" "${B}WM${R}     : Window Manager" "${B}Theme${R}  : Light" "${B}Icons${R}  : Fluent" "")
echo
for i in "${!art[@]}"; do printf ' %-36s %s│%s %s\n' "${art[$i]}" "$G" "$R" "${info[$i]}"; done
printf ' %-36s %s│%s ' "" "$G" "$R"
for c in 229,143,176 247,198,162 127,214,194 62,201,194 74,159,240 240,160,200 184,160,224 245,217,138 142,197,245; do printf '\e[48;2;%sm  \e[0m' "${c//,/;}"; done
echo; echo
